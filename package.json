{
  "name": "pi-shell-reminder",
  "version": "0.1.0",
  "description": "Pi extension that warns when Pi is started outside a project's local development shell.",
  "type": "module",
  "license": "MIT",
  "author": "Jordan Munch O'Hare",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jeprecated/pi-shell-reminder.git"
  },
  "bugs": {
    "url": "https://github.com/jeprecated/pi-shell-reminder/issues"
  },
  "homepage": "https://github.com/jeprecated/pi-shell-reminder#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "devbox",
    "devenv",
    "nix",
    "direnv"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
